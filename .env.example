# --- banco (container Postgres compartilhado do EasyPanel) ---
DATABASE_URL=postgres://fisco:senha@postgres:5432/fisco

# --- API ---
PORT=3000
JWT_SECRET=troque-isto
CORS_ORIGINS=https://fisco.judinfo.com.br,http://localhost:5173

# --- IA (OpenRouter) ---
# Configuracao vencedora do benchmark: Haiku 5.5 com raciocinio DESLIGADO.
# Ver docs/BENCHMARK.md. A hierarquia e configuravel: o backend obedece esta ordem.
OPENROUTER_API_KEY=
MODELO_PREENCHIMENTO=anthropic/claude-haiku-5.5
MODELO_PREENCHIMENTO_FALLBACK=deepseek/deepseek-v4.1-flash
RACIOCINIO_DESLIGADO=true

# --- enriquecimento sob demanda ---
APIBRASIL_TOKEN=
INFOSIMPLES_TOKEN=
DATAJUD_API_KEY=
# DJEN exige IP brasileiro
DJEN_BASE_URL=https://comunicaapi.pje.jus.br/api/v1

# --- Hermes: maturidade jurisprudencial ---
HERMES_BASE_URL=https://jurisprudencia.judinfo.com.br/api

# --- NEXUS: ordem de servico de calculo tributario ---
NEXUS_BASE_URL=https://peritobancario.com.br/api
NEXUS_API_KEY=

# --- pagamento e e-mail ---
ASAAS_API_KEY=
RESEND_API_KEY=
EMAIL_REMETENTE=no-reply@fisco.judinfo.com.br

# --- processos: iAndamento descobre, DataJud enriquece ---
IANDAMENTO_BASE_URL=https://iandamento.judinfo.com.br/api
IANDAMENTO_API_KEY=

# --- Jev (TypeSafe): classificacao sem LLM ---
JEV_BASE_URL=

# --- mensageria ---
POSTEIO_BASE_URL=https://email.judinfo.com.br
POSTEIO_AUTH=usuario:senha
OPENWA_BASE_URL=http://openwa:8080
OPENWA_API_KEY=
